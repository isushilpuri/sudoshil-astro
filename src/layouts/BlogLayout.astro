---
import type { CollectionEntry } from 'astro:content';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  readTime: string;
  tags: string[];
  headerGradient: string;
  accentColor: string;
  calloutBg: string;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { title, description, date, readTime, tags, headerGradient, accentColor, calloutBg, prevPost, nextPost } = Astro.props;
---

<!doctype html>
<html lang="en" style={`--accent-color: ${accentColor}; --callout-bg: ${calloutBg};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content={description} />
    <title>{title} | Sudoshil</title>
    <link rel="stylesheet" href="/assets/vendors/themify-icons/css/themify-icons.css" />
    <link rel="stylesheet" href="/assets/css/meyawo.css" />
    <style is:global>
      body { background: #f8f9fa; }

      .blog-post-header {
        color: #fff;
        padding: 80px 0 50px;
        margin-bottom: 0;
      }
      .blog-post-header .back-link {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 24px;
        transition: color 0.2s;
      }
      .blog-post-header .back-link:hover { color: #fff; }
      .blog-post-header h1 { font-size: 2.2rem; font-weight: 700; line-height: 1.3; margin-bottom: 16px; }
      .blog-meta { font-size: 0.88rem; color: rgba(255,255,255,0.75); }
      .blog-meta span { margin-right: 20px; }

      .tag-badge {
        display: inline-block;
        background: rgba(255,255,255,0.2);
        color: #fff;
        border-radius: 999px;
        padding: 4px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-right: 6px;
      }

      .blog-body {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.07);
        padding: 48px 56px;
        margin-top: -30px;
        margin-bottom: 60px;
        max-width: 820px;
      }
      .blog-body h2 { font-size: 1.4rem; font-weight: 700; color: var(--accent-color, #695aa6); margin: 36px 0 12px; }
      .blog-body h3 { font-size: 1.1rem; font-weight: 700; color: #393e46; margin: 28px 0 10px; }
      .blog-body p { color: #444; line-height: 1.85; margin-bottom: 16px; }
      .blog-body ul, .blog-body ol { color: #444; line-height: 1.85; padding-left: 24px; margin-bottom: 16px; }
      .blog-body li { margin-bottom: 6px; }
      .blog-body code:not(pre code) {
        background: var(--callout-bg, #f3f0ff);
        color: var(--accent-color, #695aa6);
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 0.9em;
      }
      .blog-body pre {
        background: #1e1e2e;
        color: #cdd6f4;
        border-radius: 8px;
        padding: 20px 24px;
        overflow-x: auto;
        margin: 20px 0;
        font-size: 0.88rem;
        line-height: 1.7;
      }
      .blog-body pre code { background: none !important; color: inherit !important; padding: 0 !important; }

      .blog-body table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.9rem; }
      .blog-body th { background: var(--callout-bg, #f3f0ff); color: var(--accent-color, #695aa6); padding: 10px 14px; text-align: left; }
      .blog-body td { padding: 10px 14px; border-bottom: 1px solid #eee; color: #444; }

      .callout {
        border-left: 4px solid var(--accent-color, #695aa6);
        background: var(--callout-bg, #f3f0ff);
        border-radius: 0 8px 8px 0;
        padding: 14px 20px;
        margin: 20px 0;
        color: #444;
      }
      .callout.tip {
        border-left-color: #ff6d02;
        background: #fff5ec;
      }

      .custom-navbar { position: relative !important; }
      .custom-navbar .logo { color: #695aa6; }

      #blog-post-nav { margin-bottom: 48px; max-width: 820px; }
      .blog-post-nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-top: 1px solid #eee;
        padding-top: 28px;
      }
      .blog-nav-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #393e46;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid #eee;
        background: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
        min-width: 0;
        max-width: 42%;
      }
      .blog-nav-btn:hover { border-color: #695aa6; box-shadow: 0 2px 10px rgba(105,90,166,0.12); color: #695aa6; text-decoration: none; }
      .blog-nav-disabled { visibility: hidden; }
      .blog-nav-arrow { font-size: 1.3rem; color: #695aa6; flex-shrink: 0; }
      .blog-nav-label { display: flex; flex-direction: column; min-width: 0; }
      .blog-nav-hint { font-size: 0.75rem; color: #999; text-transform: uppercase; letter-spacing: 0.05em; }
      .blog-nav-title { font-size: 0.9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .blog-nav-next .blog-nav-label { text-align: right; }
      .blog-nav-all {
        font-size: 0.85rem;
        color: #695aa6;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 999px;
        border: 1px solid #695aa6;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background 0.2s, color 0.2s;
      }
      .blog-nav-all:hover { background: #695aa6; color: #fff; text-decoration: none; }

      @media (max-width: 768px) {
        .blog-body { padding: 28px 20px; }
        .blog-post-header h1 { font-size: 1.6rem; }
      }
    </style>
  </head>
  <body>
    <nav class="custom-navbar">
      <div class="container">
        <a class="logo" href="/">Sudoshil</a>
        <ul class="nav">
          <li class="item"><a class="link" href="/#home">Home</a></li>
          <li class="item"><a class="link" href="/#about">About</a></li>
          <li class="item"><a class="link" href="/#portfolio">Projects</a></li>
          <li class="item"><a class="link active" href="/#blog">Blog</a></li>
          <li class="item"><a class="link" href="/#contact">Contact</a></li>
        </ul>
        <a href="javascript:void(0)" id="nav-toggle" class="hamburger hamburger--elastic">
          <div class="hamburger-box"><div class="hamburger-inner"></div></div>
        </a>
      </div>
    </nav>

    <div class="blog-post-header" style={`background: ${headerGradient};`}>
      <div class="container">
        <a class="back-link" href="/#blog"><i class="ti-arrow-left"></i> Back to Blog</a>
        <div class="mb-2">
          {tags.map(tag => <span class="tag-badge">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <div class="blog-meta">
          <span><i class="ti-calendar"></i>&nbsp; {date}</span>
          <span><i class="ti-time"></i>&nbsp; {readTime}</span>
          <span><i class="ti-user"></i>&nbsp; Sushil Kumar</span>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="blog-body">
        <slot />
      </div>
    </div>

    <div class="container">
      <div id="blog-post-nav">
        <div class="blog-post-nav-inner">
          {prevPost
            ? (
              <a href={`/blog/${prevPost.slug}`} class="blog-nav-btn blog-nav-prev">
                <span class="blog-nav-arrow">&#8592;</span>
                <span class="blog-nav-label">
                  <span class="blog-nav-hint">Previous</span>
                  <span class="blog-nav-title">{prevPost.data.title}</span>
                </span>
              </a>
            )
            : <span class="blog-nav-btn blog-nav-prev blog-nav-disabled"></span>
          }
          <a href="/#blog" class="blog-nav-all">All Posts</a>
          {nextPost
            ? (
              <a href={`/blog/${nextPost.slug}`} class="blog-nav-btn blog-nav-next">
                <span class="blog-nav-label">
                  <span class="blog-nav-hint">Next</span>
                  <span class="blog-nav-title">{nextPost.data.title}</span>
                </span>
                <span class="blog-nav-arrow">&#8594;</span>
              </a>
            )
            : <span class="blog-nav-btn blog-nav-next blog-nav-disabled"></span>
          }
        </div>
      </div>
    </div>

    <Footer />

    <script is:inline>
      document.getElementById('nav-toggle').addEventListener('click', function() {
        this.classList.toggle('is-active');
        document.querySelector('ul.nav').classList.toggle('show');
      });
    </script>
  </body>
</html>

---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Sushil Kumar | Contact Center Engineer',
  description = 'Contact Center Engineer specialising in Amazon Connect, Lex V2, and AWS Lambda.',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content={description} />
    <meta name="author" content="Sushil Kumar" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (controls what Google + social media show) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Sudoshil" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@sudoshil" />

    <title>{title}</title>
    <link rel="stylesheet" href="/assets/vendors/themify-icons/css/themify-icons.css" />
    <link rel="stylesheet" href="/assets/css/meyawo.css" />
    <style is:global>
      .blog-tag {
        display: inline-block;
        background: #f3f0ff;
        color: #695aa6;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 4px;
      }

      .service-card .body .title {
        transition: opacity 0.25s, visibility 0.25s;
      }
      .service-card:hover .body img.icon {
        opacity: 0;
        visibility: hidden;
        margin-top: 0;
        margin-bottom: 0;
        width: 0;
      }
      .service-card:hover .body .title {
        opacity: 0;
        visibility: hidden;
      }
      .service-card:hover .body .subtitle {
        top: 50%;
        left: 0;
        right: 0;
        bottom: auto;
        transform: translateY(-50%);
        padding: 0 20px;
        font-size: 0.88rem;
        line-height: 1.65;
        color: #393e46;
      }

      .folio-tag {
        display: inline-block;
        background: #fff;
        color: #695aa6;
        border: 1px solid #695aa6;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.72rem;
        font-weight: 700;
        margin: 3px 3px 0 0;
        letter-spacing: 0.02em;
      }

      /* Action buttons on a portfolio card (used via the `links` field). */
      .folio-btn {
        display: inline-block;
        border: none;
        border-radius: 999px;
        padding: 10px 20px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
        margin: 4px;
      }
      .folio-btn-primary {
        background-color: #007bff;
        color: #fff;
      }
      .folio-btn-outline {
        background-color: #fff;
        color: #007bff;
      }

      .portfolio-card-overlay .portfolio-card-caption h4 {
        color: #fff;
        font-size: 1.1rem;
        margin-bottom: 6px;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
      }
      /* Description is hidden by default and revealed on hover/tap. */
      .portfolio-card-overlay .portfolio-card-caption p {
        color: #f3f0ff;
        font-size: 0.83rem;
        line-height: 1.5;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        margin: 0;
        transition: max-height 0.35s ease, opacity 0.35s ease, margin 0.35s ease;
      }
      .portfolio-card:hover .portfolio-card-overlay .portfolio-card-caption p,
      .portfolio-card:focus-within .portfolio-card-overlay .portfolio-card-caption p {
        max-height: 260px;
        opacity: 1;
        margin: 0 0 8px;
      }

      .about-caption p {
        margin-bottom: 0.6rem;
      }
      .about-caption strong {
        color: #695aa6;
      }
    </style>
  </head>
  <body data-spy="scroll" data-target=".navbar" data-offset="40" id="home">
    <slot />
  </body>
</html>

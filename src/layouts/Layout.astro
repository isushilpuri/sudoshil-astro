---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Sushil Kumar | Contact Center Engineer',
  description = 'Contact Center Engineer specialising in Amazon Connect, Lex V2, and AWS Lambda.',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content={description} />
    <meta name="author" content="Sushil Kumar" />
    <meta name="theme-color" content="#0a0e17" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (controls what Google + social media show) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Sudoshil" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@sudoshil" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="home">
    <slot />

    <!-- Resume gate: SHA-256 password-protected modal -->
    <script is:inline>
      (function () {
        var SALT        = 'a3f7c219e84b';
        var STORED_HASH = '257c1e96b3dbedc80b1c994cae8a8847a50590c286d7117d98ed28610d72d4d5';
        var RESUME_URL  = '/SushilKumar_Resume.html';
        var MAX_ATTEMPTS = 5;

        function attempts() { return parseInt(sessionStorage.getItem('rg_attempts') || '0', 10); }
        function bumpAttempts() { sessionStorage.setItem('rg_attempts', attempts() + 1); }
        function isLocked() { return attempts() >= MAX_ATTEMPTS; }
        function hasAccess() { return sessionStorage.getItem('rg_access') === '1'; }
        function grantAccess() { sessionStorage.setItem('rg_access', '1'); }

        function sha256hex(str) {
          var buf = new TextEncoder().encode(str);
          return crypto.subtle.digest('SHA-256', buf).then(function (hash) {
            return Array.from(new Uint8Array(hash))
              .map(function (b) { return b.toString(16).padStart(2, '0'); })
              .join('');
          });
        }

        function buildModal() {
          var el = document.createElement('div');
          el.id = 'rg-modal';
          el.setAttribute('role', 'dialog');
          el.setAttribute('aria-modal', 'true');
          el.setAttribute('aria-labelledby', 'rg-title');
          el.innerHTML = [
            '<div class="rg-backdrop"></div>',
            '<div class="rg-card">',
            '  <button class="rg-close" aria-label="Close">&times;</button>',
            '  <div class="rg-lock-icon">',
            '    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">',
            '      <path d="M18 8h-1V6A5 5 0 0 0 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0',
            '            2-2V10a2 2 0 0 0-2-2zM9 6a3 3 0 0 1 6 0v2H9V6zm3 9a2 2 0 1 1 0-4 2 2 0 0 1',
            '            0 4z"/>',
            '    </svg>',
            '  </div>',
            '  <h2 id="rg-title" class="rg-title">Protected Content</h2>',
            '  <p class="rg-desc">Enter the access password to view the resume.</p>',
            '  <form id="rg-form" novalidate>',
            '    <div class="rg-field">',
            '      <input type="password" id="rg-pw" placeholder="Password" autocomplete="current-password" required>',
            '      <button type="button" class="rg-toggle-pw" aria-label="Show password" tabindex="-1">',
            '        <svg id="rg-eye-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">',
            '          <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5',
            '                12 4.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>',
            '        </svg>',
            '      </button>',
            '    </div>',
            '    <div id="rg-error" class="rg-error" role="alert" aria-live="polite"></div>',
            '    <button type="submit" id="rg-submit" class="rg-btn">',
            '      <span class="rg-btn-label">Unlock Resume</span>',
            '      <span class="rg-spinner" aria-hidden="true"></span>',
            '    </button>',
            '  </form>',
            '</div>'
          ].join('');
          document.body.appendChild(el);

          el.querySelector('.rg-backdrop').addEventListener('click', hide);
          el.querySelector('.rg-close').addEventListener('click', hide);
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
          document.getElementById('rg-form').addEventListener('submit', handleSubmit);
          el.querySelector('.rg-toggle-pw').addEventListener('click', function () {
            var input = document.getElementById('rg-pw');
            var isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            this.setAttribute('aria-label', isText ? 'Show password' : 'Hide password');
          });
        }

        function show() {
          document.getElementById('rg-modal').classList.add('rg-active');
          document.body.style.overflow = 'hidden';
          document.getElementById('rg-pw').focus();
        }

        function hide() {
          var modal = document.getElementById('rg-modal');
          if (!modal) return;
          modal.classList.remove('rg-active');
          document.body.style.overflow = '';
        }

        function setLoading(on) {
          var btn = document.getElementById('rg-submit');
          btn.disabled = on;
          btn.querySelector('.rg-btn-label').style.visibility = on ? 'hidden' : '';
          btn.querySelector('.rg-spinner').style.display = on ? 'inline-block' : 'none';
        }

        function showError(msg) {
          document.getElementById('rg-error').textContent = msg;
          var field = document.getElementById('rg-pw').parentElement;
          field.classList.add('rg-shake');
          field.addEventListener('animationend', function () { field.classList.remove('rg-shake'); }, { once: true });
        }

        function handleSubmit(e) {
          e.preventDefault();
          if (isLocked()) { showError('Too many incorrect attempts. Please try again later.'); return; }
          var pw = document.getElementById('rg-pw').value;
          if (!pw) { showError('Please enter the password.'); return; }
          setLoading(true);
          document.getElementById('rg-error').textContent = '';
          sha256hex(SALT + pw).then(function (hash) {
            setLoading(false);
            if (hash === STORED_HASH) {
              grantAccess();
              hide();
              window.open(RESUME_URL, '_blank');
            } else {
              bumpAttempts();
              var left = MAX_ATTEMPTS - attempts();
              if (left <= 0) {
                showError('Too many incorrect attempts. Please try again later.');
                document.getElementById('rg-submit').disabled = true;
              } else {
                showError('Incorrect password. ' + left + ' attempt' + (left === 1 ? '' : 's') + ' remaining.');
              }
              document.getElementById('rg-pw').value = '';
              document.getElementById('rg-pw').focus();
            }
          }).catch(function () {
            setLoading(false);
            showError('Something went wrong. Please try again.');
          });
        }

        function injectStyles() {
          var css = [
            '#rg-modal{display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;}',
            '#rg-modal.rg-active{display:flex;}',
            '.rg-backdrop{position:absolute;inset:0;background:rgba(5,8,15,.72);backdrop-filter:blur(6px);}',
            '.rg-card{position:relative;z-index:1;background:#0d1220;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:44px 40px 36px;width:100%;max-width:390px;margin:16px;box-shadow:0 24px 64px rgba(0,0,0,.55);text-align:center;}',
            '.rg-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:1.5rem;color:#6b788f;cursor:pointer;padding:4px 8px;border-radius:6px;transition:color .2s;line-height:1;}',
            '.rg-close:hover{color:#22d3ee;}',
            '.rg-lock-icon{width:54px;height:54px;background:linear-gradient(120deg,rgba(34,211,238,.16),rgba(192,132,252,.16));border:1px solid rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:#22d3ee;}',
            '.rg-lock-icon svg{width:26px;height:26px;}',
            '.rg-title{font-size:1.24rem;font-weight:700;color:#e7edf6;margin-bottom:8px;font-family:"Space Grotesk",sans-serif;}',
            '.rg-desc{color:#9aa7bd;font-size:.88rem;margin-bottom:22px;line-height:1.5;}',
            '.rg-field{position:relative;margin-bottom:14px;text-align:left;}',
            '.rg-field input{width:100%;padding:11px 44px 11px 14px;border:1px solid rgba(255,255,255,.14);border-radius:10px;font-size:.95rem;color:#e7edf6;outline:none;transition:border-color .2s,box-shadow .2s;background:rgba(255,255,255,.03);font-family:inherit;letter-spacing:.05em;}',
            '.rg-field input::placeholder{color:#6b788f;}',
            '.rg-field input:focus{border-color:#38bdf8;box-shadow:0 0 0 3px rgba(56,189,248,.18);background:rgba(255,255,255,.05);}',
            '.rg-field.rg-shake input{animation:rg-shake .35s ease;}',
            '.rg-toggle-pw{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#6b788f;padding:0;display:flex;align-items:center;transition:color .2s;}',
            '.rg-toggle-pw:hover{color:#22d3ee;}',
            '.rg-toggle-pw svg{width:18px;height:18px;}',
            '.rg-error{color:#f87171;font-size:.82rem;min-height:18px;margin-bottom:12px;text-align:left;}',
            '.rg-btn{width:100%;padding:12px;background:linear-gradient(120deg,#22d3ee,#818cf8,#c084fc);color:#05080f;border:none;border-radius:10px;font-size:.95rem;font-weight:700;cursor:pointer;transition:transform .12s,box-shadow .2s;font-family:inherit;position:relative;display:flex;align-items:center;justify-content:center;}',
            '.rg-btn:hover:not(:disabled){box-shadow:0 12px 30px -10px rgba(56,189,248,.6);}',
            '.rg-btn:active:not(:disabled){transform:scale(.98);}',
            '.rg-btn:disabled{opacity:.6;cursor:not-allowed;}',
            '.rg-spinner{display:none;width:18px;height:18px;border:2.5px solid rgba(5,8,15,.35);border-top-color:#05080f;border-radius:50%;position:absolute;animation:rg-spin .7s linear infinite;}',
            '@keyframes rg-spin{to{transform:rotate(360deg);}}',
            '@keyframes rg-shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-6px);}75%{transform:translateX(6px);}}'
          ].join('');
          var s = document.createElement('style');
          s.textContent = css;
          document.head.appendChild(s);
        }

        function init() {
          injectStyles();
          buildModal();
          var btns = document.querySelectorAll('#view-resume-btn, .view-resume-btn');
          if (!btns.length) return;
          btns.forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              if (hasAccess()) {
                window.open(RESUME_URL, '_blank');
              } else {
                show();
              }
            });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>

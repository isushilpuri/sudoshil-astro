---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<section class="section" id="blog">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Writing</p>
      <h2 class="section-title">From the blog</h2>
      <p class="section-desc">Notes on Amazon Connect, Lex, Python and whatever I'm learning.</p>
    </div>

    <div class="card-grid blog-grid">
      {posts.map((post, i) => (
        <a href={`/blog/${post.slug}`} class="card blog-card reveal" data-delay={String(i % 3)}>
          <div class="meta">
            <span>{post.data.date}</span>
            <span class="sep">•</span>
            <span>{post.data.readTime}</span>
          </div>
          <div class="blog-tags">
            {post.data.tags.slice(0, 3).map((tag) => <span class="chip">{tag}</span>)}
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="blog-read">
            Read article
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<section class="section" id="blog">
  <div class="container text-center">
    <p class="section-subtitle">My Thoughts &amp; Learnings</p>
    <h6 class="section-title mb-6">Blog</h6>
    <div class="row">
      {posts.map(post => (
        <div class="col-md-4">
          <div class="card mb-4 shadow-sm h-100">
            <div class="card-body text-left d-flex flex-column">
              <div class="mb-2">
                {post.data.tags.map(tag => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>
              <h5 class="card-title">{post.data.title}</h5>
              <p class="card-text text-muted" style="font-size:0.85rem;">
                {post.data.date}&nbsp;&middot;&nbsp;{post.data.readTime}
              </p>
              <p class="card-text flex-grow-1">{post.data.description}</p>
              <a href={`/blog/${post.slug}`} class="btn btn-outline-primary btn-sm mt-2 align-self-start">
                Read More
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
const mailIcon = 'M4 4h16v16H4zM4 6l8 6 8-6';
---

<section class="section" id="contact">
  <div class="container">
    <div class="contact-card reveal">
      <p class="eyebrow center" style="justify-content:center;">Let's talk</p>
      <h2>Have a project in mind?</h2>
      <p>
        Whether it's an IVR build, a Lex bot that needs rescuing, or just a chat about conversational AI —
        my inbox is open.
      </p>
      <a href="mailto:isushilpuri@gmail.com" class="btn btn-primary" style="margin:0 auto;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={mailIcon} /></svg>
        isushilpuri@gmail.com
      </a>
    </div>
  </div>
</section>

---
---

<nav class="custom-navbar" id="main-navbar">
  <div class="container">
    <a class="logo" href="/">Sudoshil</a>
    <ul class="nav">
      <li class="item"><a class="link" href="#home">Home</a></li>
      <li class="item"><a class="link" href="#about">About</a></li>
      <li class="item"><a class="link" href="#portfolio">Projects</a></li>
      <li class="item"><a class="link" href="#blog">Blog</a></li>
      <li class="item"><a class="link" href="#contact">Contact</a></li>
    </ul>
    <a href="javascript:void(0)" id="nav-toggle" class="hamburger hamburger--elastic">
      <div class="hamburger-box">
        <div class="hamburger-inner"></div>
      </div>
    </a>
  </div>
</nav>

<script>
  // Hamburger toggle
  const navToggle = document.getElementById('nav-toggle');
  const navList = document.querySelector('ul.nav');
  if (navToggle && navList) {
    navToggle.addEventListener('click', () => {
      navToggle.classList.toggle('is-active');
      navList.classList.toggle('show');
    });
  }

  // Smooth scroll for hash nav links
  document.querySelectorAll('.nav .link').forEach(link => {
    link.addEventListener('click', function (e) {
      const href = this.getAttribute('href') ?? '';
      if (!href.startsWith('#')) return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
      history.pushState(null, '', href);
    });
  });

  // Affix — add sticky class after scrolling 20 px
  const nav = document.getElementById('main-navbar');
  if (nav) {
    const updateAffix = () => {
      if (window.scrollY > 20) {
        nav.classList.add('affix');
      } else {
        nav.classList.remove('affix');
      }
    };
    window.addEventListener('scroll', updateAffix, { passive: true });
  }
</script>

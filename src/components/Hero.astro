---

<header class="hero" id="home">
  <div class="container hero-grid">
    <div>
      <div class="hero-status reveal">
        <span class="status-dot"></span> Available for new projects
      </div>

      <h1 class="reveal" data-delay="1">
        <span class="line">Hi, I'm Sushil.</span>
        <span class="line gradient-text">I build conversational AI.</span>
      </h1>

      <p class="hero-role reveal" data-delay="2">
        <span class="accent">&gt;</span> Contact Center Engineer
        <span class="term-cursor" style="height:1em"></span>
      </p>

      <p class="hero-lead reveal" data-delay="2">
        I design enterprise-grade conversational IVR on <strong>Amazon Connect</strong>,
        <strong>Lex&nbsp;V2</strong>, <strong>Lambda</strong> and <strong>Bedrock Agents</strong> —
        shipping self-service that banks and their customers actually trust.
      </p>

      <div class="hero-actions reveal" data-delay="3">
        <a href="#projects" class="btn btn-primary">
          View my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="mailto:isushilpuri@gmail.com" class="btn btn-ghost">Get in touch</a>
      </div>

      <div class="hero-socials reveal" data-delay="4">
        {socials.map((s) => (
          <a class="social-btn" href={s.href} target="_blank" rel="noreferrer" aria-label={s.label}>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>

    <div class="reveal" data-delay="2">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="tdot r"></span><span class="tdot y"></span><span class="tdot g"></span>
          <span class="tname">sushil@aws — ivr-shell</span>
        </div>
        <div class="terminal-body" id="terminal-body"></div>
      </div>
    </div>
  </div>
</header>

<script>
  const lines = [
    { p: '$', cmd: 'whoami', out: 'Contact Center Engineer @ Cognizant' },
    { p: '$', cmd: 'cat stack.txt', out: 'Amazon Connect · Lex V2 · Lambda · Bedrock' },
    { p: '$', cmd: 'metrics --show', out: '82% speech recognition · 60% containment' },
    { p: '$', cmd: 'status', out: 'Available for work ●' },
  ];

  const body = document.getElementById('terminal-body');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function renderStatic() {
    if (!body) return;
    body.innerHTML = lines.map(l =>
      `<div class="term-line"><span class="term-prompt">${l.p}</span> <span class="term-path">~</span> ${l.cmd}</div>` +
      `<div class="term-line term-out">${l.out}</div>`
    ).join('');
  }

  async function type() {
    if (!body) return;
    const sleep = (ms) => new Promise(r => setTimeout(r, ms));
    for (const l of lines) {
      const cmdEl = document.createElement('div');
      cmdEl.className = 'term-line';
      cmdEl.innerHTML = `<span class="term-prompt">${l.p}</span> <span class="term-path">~</span> <span class="cmd"></span><span class="term-cursor"></span>`;
      body.appendChild(cmdEl);
      const target = cmdEl.querySelector('.cmd');
      const cursor = cmdEl.querySelector('.term-cursor');
      for (const ch of l.cmd) { target.textContent += ch; await sleep(38); }
      cursor.remove();
      const outEl = document.createElement('div');
      outEl.className = 'term-line term-out';
      outEl.textContent = l.out;
      body.appendChild(outEl);
      await sleep(560);
    }
    const final = document.createElement('div');
    final.className = 'term-line';
    final.innerHTML = `<span class="term-prompt">$</span> <span class="term-path">~</span> <span class="term-cursor"></span>`;
    body.appendChild(final);
  }

  if (reduce) { renderStatic(); }
  else {
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(e => { if (e.isIntersecting) { type(); obs.disconnect(); } });
    }, { threshold: 0.4 });
    if (body) io.observe(body);
  }
</script>
